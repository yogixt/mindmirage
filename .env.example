# ──────────────────────────────────────────────────────────
# Mind Mirage — environment variables
# Copy this file to .env.local and fill in the values you have.
# Everything is optional in development — features simply
# fall back to a graceful "not configured" state if missing.
# ──────────────────────────────────────────────────────────

# ──── Sant Ai (the AI chat widget) ────────────────────────
#
# Production: Groq free tier.
#   1. Go to https://console.groq.com and sign up (free).
#   2. Create an API key.
#   3. Paste it here.
#
# Optional: override the default model.
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Local dev: use Ollama running on your laptop.
#   1. Install Ollama from https://ollama.com
#   2. Pull a model:   ollama pull gemma3:4b
#   3. Set USE_OLLAMA=1 below and OLLAMA_MODEL if not gemma3:4b.
# USE_OLLAMA=1
# OLLAMA_MODEL=gemma3:4b
# OLLAMA_BASE_URL=http://localhost:11434/api


# ──── Form fan-out ────────────────────────────────────────
#
# Every form (enroll, booking, inquiry, internship, volunteer)
# forwards to BOTH of the following if configured:
#
#   1. Google Apps Script webhook → writes a row to a Google Sheet.
#      Free. Setup steps:
#        • Create a Google Sheet at https://sheets.google.com
#        • Extensions → Apps Script
#        • Paste the script from the project README
#        • Deploy → Web app → Anyone (with link)
#        • Copy the /exec URL here.
GOOGLE_SHEETS_WEBHOOK=

#   2. Formspree → emails namaste@mindmirageindia.com
#      Free tier: 50 submissions / month.
#      https://formspree.io → create form → copy endpoint.
FORMSPREE_ENDPOINT=


# ──── Razorpay (checkout) ─────────────────────────────────
#
# Payment gateway for course enrolment.
#   1. Sign up at https://dashboard.razorpay.com
#   2. Settings → API Keys → Generate test keys (rzp_test_…).
#   3. Paste below. Swap for live keys (rzp_live_…) before launch.
#
# The secret stays server-side only — never expose it with a
# NEXT_PUBLIC_ prefix.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Same value as RAZORPAY_KEY_ID; safe to expose to the browser.
NEXT_PUBLIC_RAZORPAY_KEY_ID=


# ──── Auth.js — free Google sign-in ──────────────────────
#
# Self-hosted, no vendor. Sign-in at /sign-in with Google.
#
#   1. Generate AUTH_SECRET:   openssl rand -base64 32
#   2. Create OAuth credentials at https://console.cloud.google.com/apis/credentials
#      → OAuth 2.0 Client ID (Web application)
#      → Add Authorized redirect URI: http://localhost:3000/api/auth/callback/google
#   3. Paste the Client ID and Client Secret below.
#
# Without these, the /dashboard route redirects to /sign-in,
# which will show the Google sign-in button (sign-in will fail
# without valid Google credentials in dev).
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
